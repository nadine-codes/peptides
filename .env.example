# PeptSight environment configuration
# Without ANTHROPIC_API_KEY / APIFY_TOKEN the pipeline runs in DEMO mode (curated fallback).
# Without the Supabase keys the app cannot persist or read reports.

# --- Anthropic Claude (LLM synthesis) ---
ANTHROPIC_API_KEY=
# Optional: defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Apify (live web scraping) ---
APIFY_TOKEN=
# Optional actor IDs (defaults in lib/apify.ts):
# APIFY_REDDIT_ACTOR=trudax/reddit-scraper-lite
# APIFY_SEARCH_ACTOR=apify/google-search-scraper

# --- Supabase (data persistence + Realtime progress) ---
# Browser bundle needs the NEXT_PUBLIC_ vars to render live progress.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: writes to intel_reports + etl_runs from /api/refresh.
SUPABASE_SERVICE_ROLE_KEY=

# --- ETL refresh endpoint auth ---
# Shared secret. Must match the `peptsight_refresh_secret` value stored in
# Supabase Vault so the pg_cron job can call /api/refresh with it.
REFRESH_SECRET=
