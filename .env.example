# PeptSight environment configuration
# All keys are optional. Without them the app runs in DEMO mode with rich fallback data.

# --- Anthropic Claude (LLM synthesis) ---
ANTHROPIC_API_KEY=
# Optional: defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Apify (live web scraping) ---
APIFY_TOKEN=
# Optional: actor IDs for the live web tier. Defaults provided in lib/apify.ts.
# APIFY_REDDIT_ACTOR=trudax/reddit-scraper-lite
# APIFY_SEARCH_ACTOR=apify/google-search-scraper
